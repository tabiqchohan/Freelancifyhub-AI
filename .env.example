# ---------------------------------------------------------------------------
# Freelancify AI — Environment Configuration
# Copy to .env and adjust. Never commit real values.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Logging
LOG_LEVEL=info
# Pretty logs are a LOCAL DEVELOPMENT convenience only. `pino-pretty` is a
# devDependency and the production image runs `npm prune --omit=dev`, so the
# transport is not installed in production. src/lib/logger.ts forces structured
# JSON when NODE_ENV=production and logs a notice, so this can never prevent a
# container from starting. Leave `true` here for local use.
LOG_PRETTY=true

# Optional alternative dotenv file path (defaults to `.env`). Useful for keeping
# local profiles separate, e.g. ENV_FILE=.env.local
# ENV_FILE=.env

# Server-to-server authentication (Sprint 29 boundary)
# When non-empty, every business endpoint requires this token via the
# `x-aios-service-token` header. Liveness probes (/health, /healthz) stay open.
# Fail-closed: when this is empty, business endpoints are DENIED unless
# AIOS_ALLOW_UNAUTHENTICATED=true (ignored when NODE_ENV=production).
# Production deployments MUST set a strong value. Never commit real values.
AIOS_SERVICE_TOKEN=

# Management / admin credential (Sprint 35 F-4), presented via the
# `x-aios-admin-token` header for AG-004 tool enable/disable and registry
# management. Fail-closed: management endpoints are denied outright when this is
# empty, so they cannot be reached by naming an actor group in the query string.
# Production deployments MUST set a strong value. Never commit real values.
AIOS_ADMIN_TOKEN=

# Local development escape hatch ONLY. Runs the business API with no service
# token. Default `false`. ALWAYS IGNORED when NODE_ENV=production, so it cannot
# weaken a production deployment. Never set this to true in a deployed env.
AIOS_ALLOW_UNAUTHENTICATED=false

# --- LLM / AI reasoning (Sprint 31; see src/llm/config/schema.ts) ---
# Master flag. Anything but "true" disables AI reasoning (fail closed).
LLM_ENABLED=false
# Provider id: `mock` (deterministic, no network) or `http` (OpenAI-compatible).
LLM_PROVIDER=mock
# Model identity. The actual value MUST be verified against the provider's
# current availability before a production deployment.
LLM_MODEL=mock-model-1.0
# Secret: provider API key. REQUIRED when LLM_ENABLED=true + LLM_PROVIDER=http
# (production startup fails closed without it). Never commit real values.
LLM_API_KEY=
# OpenAI-compatible chat-completions base URL (HTTP provider only).
# Must be an absolute https URL (plaintext http is allowed only for a loopback
# gateway such as Ollama/vLLM). Credentials and query strings are rejected.
LLM_BASE_URL=https://api.openai.com/v1
# Per-ATTEMPT timeout in ms. With LLM_MAX_RETRIES=2 the worst-case total is
# roughly 3x this value, so do not set it close to the caller's own deadline.
LLM_TIMEOUT_MS=30000
# Retries after the first attempt (bounded; no infinite retries).
LLM_MAX_RETRIES=2
# Sampling temperature in [0, 2].
LLM_TEMPERATURE=0.2
# Max output tokens.
LLM_MAX_OUTPUT_TOKENS=1024
# Max context bytes assembled into a single user message.
LLM_MAX_CONTEXT_BYTES=65536
# Ceiling on the buffered upstream response body. Guards memory against a
# misconfigured or hostile LLM_BASE_URL; a normal completion is far smaller.
LLM_MAX_RESPONSE_BYTES=1048576

# OpenClaw (optional)
# Path to the OpenClaw config this repository exposes for the gateway.
# OPENCLAW_CONFIG_PATH=./clawd.json

# --- Durable memory storage (AG-002) ---------------------------------------
# Accepted values are exactly `in-memory` and `durable` — verified against
# src/app/composition-root.ts, which branches on those two literals and throws
# `UNSUPPORTED_STORAGE_BACKEND` for anything else. `postgres` is NOT a valid
# value here despite the storage engine being PostgreSQL.
#   in-memory (default, non-durable) | durable (PostgreSQL, requires the URL below)
MEMORY_STORAGE_BACKEND=in-memory
#
# DEVELOPMENT database only. Must point at a database you are willing to have
# wiped by `npm run dev` work. Production credentials MUST NOT live in a local
# file: set MEMORY_DATABASE_URL in the deployment environment / secret manager.
# Placeholder below - replace with your own LOCAL instance.
MEMORY_DATABASE_URL=postgresql://localhost:5432/aios_dev
#
# ISOLATED TEST database, used only by the integration suites under
# tests/integration. src/lib/test-database-guard.ts fails closed on it: the URL
# must be a loopback address, must not match a managed-postgres provider, and
# the database name must not look production-like. When this variable is unset
# the suites SKIP; they never fall back to MEMORY_DATABASE_URL. That fallback is
# what previously wrote test rows into the live database (prompts13 Blocker 2).
AIOS_TEST_DATABASE_URL=postgresql://localhost:5432/aios_test

# --- AI Employee (AG-701) — see src/agents/employee-ai/config.ts -------------
# Master feature flag. Fail-closed when disabled.
EMPLOYEE_ENABLED=true
#
# Task/artifact storage backend. Accepted values are exactly `in-memory` and
# `durable` (NOT `postgres`).
#   in-memory (default outside production; state lost on restart)
#   durable   (PostgreSQL task + artifact storage; DEFAULT in production)
# In production an explicit `in-memory` is REJECTED at boot so task state can
# never silently live only in RAM. Set `durable` explicitly in a deployed env.
EMPLOYEE_STORAGE_BACKEND=in-memory
#
# SECRET (contains credentials). Durable employee storage connection. When empty
# the composition root falls back to MEMORY_DATABASE_URL, so the URL is never
# duplicated. Production: inject via the deployment environment / secret manager.
EMPLOYEE_DATABASE_URL=
#
# Generated-workspace root (relative to the process CWD). Must be writable by the
# runtime user. Workspaces are ephemeral scratch space; review artifacts are
# persisted to PostgreSQL and reaped after EMPLOYEE_ARTIFACT_TTL_MS.
EMPLOYEE_WORKSPACE_ROOT=.employee-workspaces
# Per-task wall-clock budget in ms.
EMPLOYEE_MAX_EXECUTION_MS=600000
# Bounded repair attempts after a failed build.
EMPLOYEE_MAX_REPAIR_ATTEMPTS=3
# Max tool calls per task.
EMPLOYEE_MAX_TOOL_CALLS=100
# Max workspace size / single file / file count / packaged artifact bytes.
EMPLOYEE_MAX_WORKSPACE_BYTES=104857600
EMPLOYEE_MAX_FILE_BYTES=10485760
EMPLOYEE_MAX_FILE_COUNT=256
EMPLOYEE_MAX_ARTIFACT_BYTES=52428800
# Per-tool-call timeout in ms.
EMPLOYEE_TOOL_TIMEOUT_MS=15000
# Max accepted request text length in bytes.
EMPLOYEE_MAX_REQUEST_TEXT=8000
# Concurrency + bounded backlog (backpressure).
EMPLOYEE_MAX_ACTIVE_TASKS=4
EMPLOYEE_MAX_USER_ACTIVE_TASKS=1
EMPLOYEE_QUEUE_CAPACITY=16
# Retention: delete artifacts older than TTL; sweep interval for the reaper.
EMPLOYEE_ARTIFACT_TTL_MS=86400000
EMPLOYEE_REAP_INTERVAL_MS=600000
