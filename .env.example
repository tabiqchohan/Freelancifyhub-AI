# ---------------------------------------------------------------------------
# Freelancify AI — Environment Configuration
# Copy to .env and adjust. Never commit real values.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Server-to-server authentication (Sprint 29 boundary)
# When non-empty, every business endpoint requires this token via the
# `x-aios-service-token` header. Liveness probes (/health, /healthz) stay open.
# Production deployments MUST set a strong value. Never commit real values.
AIOS_SERVICE_TOKEN=

# --- LLM / AI reasoning (Sprint 31; see src/llm/config/schema.ts) ---
# Master flag. Anything but "true" disables AI reasoning (fail closed).
LLM_ENABLED=false
# Provider id: `mock` (deterministic, no network) or `http` (OpenAI-compatible).
LLM_PROVIDER=mock
# Model identity. The actual value MUST be verified against the provider's
# current availability before a production deployment.
LLM_MODEL=mock-model-1.0
# Secret: provider API key. REQUIRED when LLM_ENABLED=true + LLM_PROVIDER=http
# (production startup fails closed without it). Never commit real values.
LLM_API_KEY=
# OpenAI-compatible chat-completions base URL (HTTP provider only).
LLM_BASE_URL=https://api.openai.com/v1
# Per-request timeout in ms.
LLM_TIMEOUT_MS=30000
# Retries after the first attempt (bounded; no infinite retries).
LLM_MAX_RETRIES=2
# Sampling temperature in [0, 2].
LLM_TEMPERATURE=0.2
# Max output tokens.
LLM_MAX_OUTPUT_TOKENS=1024
# Max context bytes assembled into a single user message.
LLM_MAX_CONTEXT_BYTES=65536

# OpenClaw (optional)
# Path to the OpenClaw config this repository exposes for the gateway.
# OPENCLAW_CONFIG_PATH=./clawd.json
